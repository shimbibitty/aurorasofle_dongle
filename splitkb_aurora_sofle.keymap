// ============================================================
//  Aurora Sofle v2 — ZMK Keymap
//  Board:  splitkb Aurora Sofle (left + right + dongle)
//  Layers: 0 QWERTY  1 LOWER  2 RAISE  3 ADJUST
// ============================================================

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

// ── Layer indices ────────────────────────────────────────────
#define QWERTY  0
#define LOWER   1
#define RAISE   2
#define ADJUST  3

// ── Convenience aliases ──────────────────────────────────────
#define XXXXXXX &none
#define _______ &trans

/ {
    // ── Combos ──────────────────────────────────────────────
    combos {
        compatible = "zmk,combos";

        // Press both encoder buttons together to toggle ZMK Studio unlock
        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <52 57>;   // left-enc + right-enc
            bindings = <&studio_unlock>;
        };
    };

    // ── Behaviors ───────────────────────────────────────────
    behaviors {
        rot_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };
    };

    // ── Keymap ──────────────────────────────────────────────
    keymap {
        compatible = "zmk,keymap";

        // ── Layer 0 — QWERTY ────────────────────────────────
        // ┌─────┬─────┬─────┬─────┬─────┬─────┐                    ┌─────┬─────┬─────┬─────┬─────┬─────┐
        // │  `  │  1  │  2  │  3  │  4  │  5  │                    │  6  │  7  │  8  │  9  │  0  │BSPC │
        // ├─────┼─────┼─────┼─────┼─────┼─────┤                    ├─────┼─────┼─────┼─────┼─────┼─────┤
        // │ TAB │  Q  │  W  │  E  │  R  │  T  │                    │  Y  │  U  │  I  │  O  │  P  │  \  │
        // ├─────┼─────┼─────┼─────┼─────┼─────┤                    ├─────┼─────┼─────┼─────┼─────┼─────┤
        // │ ESC │  A  │  S  │  D  │  F  │  G  │                    │  H  │  J  │  K  │  L  │  ;  │  '  │
        // ├─────┼─────┼─────┼─────┼─────┼─────┼─────┐    ┌─────┬──┴─────┼─────┼─────┼─────┼─────┼─────┤
        // │SHFT │  Z  │  X  │  C  │  V  │  B  │MUTE │    │PLAY │  N  │  M  │  ,  │  .  │  /  │SHFT │
        // └─────┴─────┴─────┼─────┼─────┼─────┼─────┘    └─────┼─────┼─────┼─────┼─────┴─────┴─────┘
        //                   │ GUI │ ALT │CTRL │LOWR │    │RAIS │ENTR │ SPC │ ALT │
        //                   └─────┴─────┴─────┴─────┘    └─────┴─────┴─────┴─────┘
        qwerty_layer {
            display-name = "QWERTY";
            bindings = <
                &kp GRAVE  &kp N1    &kp N2    &kp N3    &kp N4    &kp N5                              &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp BSPC
                &kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T                               &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSLH
                &kp ESC    &kp A     &kp S     &kp D     &kp F     &kp G                               &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
                &kp LSHFT  &kp Z     &kp X     &kp C     &kp V     &kp B     &kp C_MUTE    &kp C_PP   &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
                                     &kp LGUI  &kp LALT  &kp LCTRL &mo LOWER                           &mo RAISE &kp RET   &kp SPACE &kp RALT
            >;
            sensor-bindings = <&rot_kp C_VOL_DN C_VOL_UP &rot_kp PG_DN PG_UP>;
        };

        // ── Layer 1 — LOWER  (symbols & F-keys) ─────────────
        lower_layer {
            display-name = "LOWER";
            bindings = <
                &kp F1     &kp F2    &kp F3    &kp F4    &kp F5    &kp F6                              &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
                _______    &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT                           &kp CARET &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR  &kp DEL
                _______    _______   _______   _______   &kp MINUS &kp UNDER                           &kp EQUAL &kp PLUS  &kp LBKT  &kp RBKT  &kp PIPE  &kp TILDE
                _______    _______   _______   _______   _______   _______   _______       _______     _______   _______   _______   _______   _______   _______
                                     _______   _______   _______   _______                             &mo ADJUST _______  _______   _______
            >;
            sensor-bindings = <&rot_kp C_VOL_DN C_VOL_UP &rot_kp LEFT RIGHT>;
        };

        // ── Layer 2 — RAISE  (navigation & numpad) ──────────
        raise_layer {
            display-name = "RAISE";
            bindings = <
                _______    _______   _______   _______   _______   _______                             _______   _______   _______   _______   _______   _______
                _______    &kp INS   &kp HOME  &kp UP    &kp END   &kp PG_UP                           &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp MINUS &kp FSLH  _______
                _______    &kp DEL   &kp LEFT  &kp DOWN  &kp RIGHT &kp PG_DN                           &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp PLUS  &kp STAR  _______
                _______    _______   _______   _______   _______   _______   _______       _______     &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_N0 &kp DOT   _______
                                     _______   _______   _______   &mo ADJUST                          _______   _______   _______   _______
            >;
            sensor-bindings = <&rot_kp C_VOL_DN C_VOL_UP &rot_kp PG_DN PG_UP>;
        };

        // ── Layer 3 — ADJUST  (BT, output, power) ───────────
        adjust_layer {
            display-name = "ADJUST";
            bindings = <
                XXXXXXX    XXXXXXX   XXXXXXX   XXXXXXX   XXXXXXX   XXXXXXX                             XXXXXXX   XXXXXXX   XXXXXXX   XXXXXXX   XXXXXXX   XXXXXXX
                XXXXXXX    XXXXXXX   XXXXXXX   XXXXXXX   XXXXXXX   XXXXXXX                             XXXXXXX   XXXXXXX   XXXXXXX   XXXXXXX   XXXXXXX   XXXXXXX
                XXXXXXX    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4          XXXXXXX   XXXXXXX   XXXXXXX   XXXXXXX   XXXXXXX   XXXXXXX
                XXXXXXX    &bt BT_CLR  XXXXXXX   XXXXXXX   XXXXXXX   XXXXXXX   XXXXXXX    XXXXXXX     XXXXXXX   XXXXXXX   XXXXXXX   XXXXXXX   XXXXXXX   XXXXXXX
                                     &out OUT_USB &out OUT_BLE XXXXXXX XXXXXXX                         XXXXXXX   XXXXXXX   &ext_power EP_TOG XXXXXXX
            >;
            sensor-bindings = <&rot_kp C_VOL_DN C_VOL_UP &rot_kp PG_DN PG_UP>;
        };
    };
};
