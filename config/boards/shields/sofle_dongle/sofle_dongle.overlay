// Aurora Sofle dongle overlay
// The dongle acts as BLE central + USB HID host — it has no physical keys.
// We must still provide a mock kscan and the keyboard's matrix transform
// so ZMK can map key events received from the peripherals.

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,physical-layout = &sofle_layout;
    };

    // Required by ZMK even though the dongle has no physical keys
    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    // Aurora Sofle v2 matrix transform — 5 rows × 14 columns = 58 keys + 2 encoders
    // Matches splitkb_aurora_sofle.dtsi in the ZMK tree
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)  RC(0,5)                   RC(0,8)  RC(0,9)  RC(0,10) RC(0,11) RC(0,12) RC(0,13)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)  RC(1,5)                   RC(1,8)  RC(1,9)  RC(1,10) RC(1,11) RC(1,12) RC(1,13)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)  RC(2,5)                   RC(2,8)  RC(2,9)  RC(2,10) RC(2,11) RC(2,12) RC(2,13)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)  RC(3,5)  RC(3,6)  RC(3,7) RC(3,8)  RC(3,9)  RC(3,10) RC(3,11) RC(3,12) RC(3,13)
                            RC(4,2) RC(4,3) RC(4,4)  RC(4,5)  RC(4,6)  RC(4,7) RC(4,8)  RC(4,9)  RC(4,10) RC(4,11)
        >;
    };

    sofle_layout: sofle_layout {
        compatible = "zmk,physical-layout";
        display-name = "Sofle Layout";
        transform = <&default_transform>;
        kscan = <&mock_kscan>;
    };
};
