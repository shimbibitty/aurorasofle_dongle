// ============================================================
//  Aurora Sofle v2 — ZMK Keymap
//  Board:  splitkb Aurora Sofle (left + right + dongle)
//  Layers: 0 QWERTY  1 LOWER  2 RAISE  3 ADJUST  4 NUMPAD
// ============================================================

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

// ── Layer indices ────────────────────────────────────────────
#define QWERTY  0
#define LOWER   1
#define RAISE   2
#define ADJUST  3
#define NUMPAD 	4

// ── Convenience aliases ──────────────────────────────────────
#define XXXXXXX &none
#define _______ &trans
#define TILDESC &mt TILDE ESC
#define SHFTESC &mt RSHFT RETURN
#define SPCELOW &lt 1 SPACE
#define ENTRNUM	&lt 4 RETURN
#define SPCRISE &lt 2 SPACE

/ {
    // ── Combos ──────────────────────────────────────────────
    combos {
        compatible = "zmk,combos";

        // Press both encoder buttons together to toggle ZMK Studio unlock
        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <52 57>;   // left-enc + right-enc
            bindings = <&studio_unlock>;
        };
    };

    // ── Behaviors ───────────────────────────────────────────
    behaviors {
        rot_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };
    };

    // ── Keymap ──────────────────────────────────────────────
    keymap {
        compatible = "zmk,keymap";

        // ── Layer 0 — QWERTY ────────────────────────────────
        // ┌─────┬─────┬─────┬─────┬─────┬─────┐                ┌─────┬─────┬─────┬─────┬─────┬─────┐
        // │ ESC │  1  │  2  │  3  │  4  │  5  │                │  6  │  7  │  8  │  9  │  0  │BSPC │
        // ├─────┼─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┼─────┤
        // │ TAB │  Q  │  W  │  E  │  R  │  T  │                │  Y  │  U  │  I  │  O  │  P  │ DEL │
        // ├─────┼─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┼─────┤
        // │CAPS │  A  │  S  │  D  │  F  │  G  │                │  H  │  J  │  K  │  L  │  ;  │  '  │
        // ├─────┼─────┼─────┼─────┼─────┼─────┼─────┐    ┌─────┼─────┼─────┼─────┼─────┼─────┼─────┴──┐
        // │SHFT │  Z  │  X  │  C  │  V  │  B  │MUTE │    │PLAY │  N  │  M  │  ,  │  .  │  /  │SHFT/RET│
        // └─────┴─────┼─────┼─────┼─────┼─────┼─────┴─┐  ├─────┼─────┼─────┼─────┼─────┼─────┴────────┘
        //             │ GUI │ ALT │CTRL │SPC/L│RET/NUM│  │BSPC │SPC/R│CTRL │ ALT │ GUI │
        //             └─────┴─────┴─────┴─────┴───────┘  └─────┴─────┴─────┴─────┴─────┘
        qwerty_layer {
            display-name = "QWERTY";
            bindings = <
                &kp ESC   &kp N1 &kp N2    &kp N3   &kp N4   &kp N5                      &kp N6  &kp N7    &kp N8    &kp N9   &kp N0   &kp BSPC
				&kp TAB   &kp Q  &kp W     &kp E    &kp R    &kp T                       &kp Y   &kp U     &kp I     &kp O    &kp P    &kp DEL
				&kp CAPS  &kp A  &kp S     &kp D    &kp F    &kp G                       &kp H   &kp J     &kp K     &kp L    &kp SEMI &kp SQT
				&kp LSHFT &kp Z  &kp X     &kp C    &kp V    &kp B &kp C_MUTE   &kp C_PP &kp N   &kp M     &kp COMMA &kp DOT  &kp FSLH SHFTESC
						  &kp LGUI &kp LALT &kp LCTRL SPCELOW ENTRNUM   		&kp BSPC SPCRISE &kp RCTRL &kp RALT  &kp RGUI
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_NEXT C_PREV>;
        };

        // ── Layer 1 — LOWER  (shortcuts, navigation) ─────────────
        // ┌─────┬─────┬─────┬─────┬─────┬─────┐                ┌─────┬─────┬─────┬─────┬─────┬─────┐
        // │ ESC │     │     │     │     │     │                │     │     │     │     │  -  │BSPC │
        // ├─────┼─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┼─────┤
        // │ TAB │     │     │PGUP │     │     │                │     │CTR+U│  UP │     │     │ DEL │
        // ├─────┼─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┼─────┤
        // │     │ ALL │SAVE │PGDN │PRNT │     │                │HOME │LEFT │DOWN │RIGHT│ END │     │
        // ├─────┼─────┼─────┼─────┼─────┼─────┼─────┐    ┌─────┼─────┼─────┼─────┼─────┼─────┼─────┴──┐
        // │SHFT │UNDO │ CUT │COPY │PASTE│     │MUTE │    │PLAY │     │PASTE│COPY │ CUT │     │SHFT/RET│
        // └─────┴─────┼─────┼─────┼─────┼─────┼─────┴─┐  ├─────┼─────┼─────┼─────┼─────┼─────┴────────┘
        //             │ GUI │ ALT │CTRL │SPC/L│RET/NUM│  │BSPC │SPC/R│CTRL │ ALT │ GUI │
        //             └─────┴─────┴─────┴─────┴───────┘  └─────┴─────┴─────┴─────┴─────┘
        lower_layer {
            display-name = "LOWER";
            bindings = <
				&trans    &none     &none     &none     &none      &none                   &none       &none      &none     &none      &kp MINUS  &trans
				&trans    &none     &none     &kp PGUP  &none      &none                   &none       &kp RC(U)  &kp UP    &none      &none      &trans
				&none     &kp LC(A) &kp LC(S) &kp PGDN  &kp PSCRN  &none		           &kp HOME    &kp LEFT   &kp DOWN  &kp RIGHT  &kp END    &none
				&trans    &kp LC(Z) &kp LC(X) &kp LC(C) &kp LC(V)  &trans  &trans  &trans  &none       &kp LC(V)  &kp LC(C) &kp LC(X)  &none      &trans
									&trans    &trans    &trans     &trans  &trans  &trans  &trans      &trans     &trans    &trans
            >;
             sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };

        // ── Layer 2 — RAISE  (function keys, symbols) ──────────
		// ┌─────┬─────┬─────┬─────┬─────┬─────┐                ┌─────┬─────┬─────┬─────┬─────┬─────┐
        // │ ESC │     │     │     │     │     │                │     │  $  │  (  │  )  │  -  │BSPC │
        // ├─────┼─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┼─────┤
        // │ TAB │ F1  │ F2  │ F3  │ F4  │ F5  │                │  !  │  @  │  #  │  $  │  %  │  ^  │
        // ├─────┼─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┼─────┤
        // │     │ F5  │ F6  │ F7  │ F8  │     │                │  ~  │  _  │  -  │  +  │  =  │  \  │
        // ├─────┼─────┼─────┼─────┼─────┼─────┼─────┐    ┌─────┼─────┼─────┼─────┼─────┼─────┼─────┴──┐
        // │SHFT │ F9  │ F10 │ F11 │ F12 │     │MUTE │    │PLAY │  *  │  &  │  [  │  ]  │  |  │SHFT/RET│
        // └─────┴─────┼─────┼─────┼─────┼─────┼─────┴─┐  ├─────┼─────┼─────┼─────┼─────┼─────┴────────┘
        //             │ GUI │ ALT │CTRL │SPC/L│RET/NUM│  │BSPC │SPC/R│CTRL │ ALT │ GUI │
        //             └─────┴─────┴─────┴─────┴───────┘  └─────┴─────┴─────┴─────┴─────┘
        raise_layer {
            display-name = "RAISE";
             bindings = <
				&trans   &none   &none   &none   &none   &none                        &none     &kp DLLR   &kp LPAR   &kp RPAR   &kp MINUS  &trans
				&trans   &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                       &kp EXCL  &kp AT     &kp HASH   &kp DLLR   &kp PRCNT  &kp CARET
				&none    &kp F5  &kp F6  &kp F7  &kp F8  &none                        &kp TILDE &kp UNDER  &kp MINUS  &kp PLUS   &kp EQUAL  &kp BSLH
				&trans   &kp F9  &kp F10 &kp F11 &kp F12 &none     &trans   &trans    &kp ASTRK &kp AMPS   &kp LBKT   &kp RBKT   &kp PIPE   &trans
								 &trans  &trans  &trans  &trans    &trans   &trans    &trans    &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // ── Layer 3 — ADJUST  (BT, output, power) ───────────
		// ┌─────┬─────┬─────┬─────┬─────┬─────┐                ┌─────┬─────┬─────┬─────┬─────┬─────┐
        // │     │     │     │     │     │     │                │     │     │     │     │     │     │
        // ├─────┼─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┼─────┤
        // │     │     │     │     │     │     │                │     │     │     │     │     │     │
        // ├─────┼─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┼─────┤
        // │     │ BT0 │ BT1 │ BT2 │ BT3 │ BT4 │                │     │     │     │     │     │     │
        // ├─────┼─────┼─────┼─────┼─────┼─────┼─────┐    ┌─────┼─────┼─────┼─────┼─────┼─────┼─────┤
        // │     │     │     │     │     │     │     │    │     │     │     │     │     │     │     │
        // └─────┴─────┼─────┼─────┼─────┼─────┼─────┤    ├─────┼─────┼─────┼─────┼─────┼─────┴─────┘
        //             │ USB │ BLE │     │     │     │    │     │     │TGPWR│     │     │
        //             └─────┴─────┴─────┴─────┴─────┘    └─────┴─────┴─────┴─────┴─────┘
        adjust_layer {
            display-name = "ADJUST";
            bindings = <
                &none	&none			&none			&none			&none			&none								&none	&none	&none	&none	&none	&none
                &none	&none			&none			&none			&none			&none								&none	&none	&none	&none	&none	&none
                &none	&bt BT_SEL 0	&bt BT_SEL 1	&bt BT_SEL 2	&bt BT_SEL 3	&bt BT_SEL 4						&none	&none	&none	&none	&none	&none
                &none	&bt BT_CLR  	&none			&none			&none			&none			&none	&none		&none	&none	&none	&none	&none	&none 
										&out OUT_USB	&out OUT_BLE	&none			&none 			&none	&none		&none   &ext_power EP_TOG &none	&none
            >;
            sensor-bindings = <&rot_kp C_VOL_DN C_VOL_UP &rot_kp PG_DN PG_UP>;
        };
		
		// ── Layer 4 — NUMPAD (Numpad) ───────────
		// ┌─────┬─────┬─────┬─────┬─────┬─────┐                ┌─────┬─────┬─────┬─────┬─────┬─────┐
        // │ ESC │     │     │     │     │     │                │     │     │     │     │  -  │BSPC │
        // ├─────┼─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┼─────┤
        // │ TAB │     │     │     │NUMLK│     │                │  /  │  7  │  8  │  9  │  -  │ DEL │
        // ├─────┼─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┼─────┤
        // │     │     │     │     │INSRT│     │                │     │  4  │  5  │  6  │  +  │     │
        // ├─────┼─────┼─────┼─────┼─────┼─────┼─────┐    ┌─────┼─────┼─────┼─────┼─────┼─────┼─────┴──┐
        // │SHFT │     │     │     │     │     │MUTE │    │PLAY │  *  │  1  │  2  │  3  │  +  │SHFT/RET│
        // └─────┴─────┼─────┼─────┼─────┼─────┼─────┤    ├─────┼─────┼─────┼─────┼─────┼─────┴────────┘
        //             │ GUI │ ALT │CTRL │SPC/L│     │    │RET  │SPC  │  0  │     │  .  │
        //             └─────┴─────┴─────┴─────┴─────┘    └─────┴─────┴─────┴─────┴─────┘
        numpad_layer {
            bindings = <
				&kp ESC		&none	&none	&none		&none	&none						&none			&none	&none	&none	&kp MINUS		&kp BSPC
				&kp TAB		&none	&none	&kp KP_NUM	&none	&none						&kp KP_DIVIDE	&kp N7	&kp N8	&kp N9	&kp KP_MINUS	&kp DEL
				&none		&none	&none	&kp INS		&none	&none						&none			&kp N4	&kp N5	&kp N6	&kp KP_PLUS		&none
				&kp LSHFT	&none	&none	&none		&none	&none	&none		&none	&kp KP_MULTIPLY	&kp N1	&kp N2	&kp N3	&kp KP_PLUS		SHFTESC
									&kp LGUI &kp LALT &kp LCTRL SPCELOW	&trans   	&kp KP_ENTER &kp SPACE	&kp N0	&none	&kp KP_DOT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};